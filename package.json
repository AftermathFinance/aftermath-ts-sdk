{
	"name": "aftermath-ts-sdk",
	"version": "2.0.0-temp.2",
	"description": "Aftermath TypeScript SDK",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "rimraf ./dist",
		"build": "tsup",
		"build:tsc": "bun run clean && tsc",
		"link": "bun link && cd ../aftermath-frontend/ && bun link aftermath-ts-sdk",
		"prepack": "bun run build",
		"prepare": "bun run build",
		"test": "jest",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "bun run build && changeset publish"
	},
	"packageManager": "bun@1.3.8",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/AftermathFinance/aftermath-ts-sdk.git"
	},
	"keywords": [
		"aftermath",
		"aftermath finance",
		"sui",
		"aftermath sdk",
		"aftermath finance sdk",
		"aftermath typescript sdk",
		"aftermath finance typescript sdk"
	],
	"author": "Aftermath",
	"license": "Apache-2.0",
	"files": [
		"dist/*"
	],
	"bugs": {
		"url": "https://github.com/AftermathFinance/aftermath-ts-sdk/issues"
	},
	"homepage": "https://github.com/AftermathFinance/aftermath-ts-sdk#readme",
	"dependencies": {
		"date-fns": "^4.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@changesets/cli": "^2.29.8",
		"@types/jest": "^29.5.2",
		"jest": "^29.5.0",
		"rimraf": "^6.0.1",
		"ts-jest": "^29.1.0",
		"ts-node": "^10.9.1",
		"tsup": "^8.5.1",
		"typescript": "^5.8.3",
		"ultracite": "7.1.5",
		"yaml": "^2.3.1"
	},
	"peerDependencies": {
		"@mysten/sui": ">=2.0.0 <3.0.0"
	}
}
